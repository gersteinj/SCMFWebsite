---
import CalendarIcon from "../assets/icons/lucide-calendar-days.svg";
import MapIcon from "../assets/icons/lucide-map.svg";
---

<div class="hero bg-base-300 min-h-[60vh]">
    <div class="hero-content flex-col lg:flex-row-reverse gap-8">

        <img src="https://placehold.co/400?text=logo" class="max-w-sm rounded-lg shadow-2xl" alt="SCMF Logo">
        <div class="flex flex-col gap-4">
            <h1 class="text-5xl font-bold">Sussex County Maker Fest</h1>
            <p class="text-2xl font-bold">October 3 & 4, 2026</p>
            <p class="text-lg">
                <span class="font-bold">Ideal Farm & Garden Center</span><br>222 NJ-15<br>Lafayetter Township, NJ 07848
            </p>
            
            <a href="https://maps.app.goo.gl/8zu8W4W4xbvVcJZs5" class="btn btn-primary"><MapIcon />View on Google Maps</a>
            <a href="#get-involved" class="btn btn-primary">Get Involved!</a>
        </div>
    </div>
</div>