---
import GenericSection from "../components/GenericSection.astro";
import SectionSubtitle from "../components/SectionSubtitle.astro";
import SectionTitle from "../components/SectionTitle.astro";

import Image from "astro/components/Image.astro";
---

<GenericSection name="Get Involved">
    <div class="flex flex-col gap-4">
        <SectionTitle name="Get Involved" />
        <p>
            Sussex County Maker Fest can't happen without our exhibitors,
            volunteers, and sponsors. Signup forms will be posted soon, but in the meantime, please <a href="#contact-us">contact us</a> to get involved.
        </p>

        <div class="flex flex-col lg:flex-row gap-4">
            <div class="card bg-base-200 shadow-sm">
                <div class="card-body">
                    <h3 class="card-title">Exhibitors</h3>
                    <p>
                        We'd love for you or your organization to become a part
                        of Sussex County Maker Fest. Agricultural speakers,
                        crafters and makers, and STEM clubs are encouraged to
                        participate. At Sussex County Maker Festival, we
                        encourage new and different participants to join us. If
                        you don't see your field mentioned in past events, fill
                        out our Call for Exhibitors form and be the first!
                    </p>
                    <p>
                        Registration is free for exhibitors and educators, but
                        there is a $50/day fee for vendors. If you're interested
                        in both vending and exhibiting, please <a
                            href="mailto:Ideal.Farms.Makers@protonmail.com"
                            >reach out</a
                        > to discuss possible discounts or waivers.
                    </p>
                    <div class="card-actions justify-end">
                        <a href="#contact-us" class="btn btn-primary text-primary-content"
                            >Exhibit or vend at SCMF</a
                        >
                    </div>
                </div>
            </div>
            <div class="flex flex-col gap-4">
                <div class="card bg-base-200 shadow-sm">
                    <div class="card-body">
                        <h3 class="card-title">Sponsors</h3>
                        <p>
                            We deeply appreciate our sponsors for helping us
                            make this event free for everyone to attend.
                        </p>
                        <div class="card-actions justify-end">
                            <a href="#our-partners" class="btn btn-primary"
                                >Our Partners</a
                            >
                            <a href="#contact-us" class="btn btn-primary"
                                >Become a Sponsor</a
                            >
                        </div>
                    </div>
                </div>

                <div class="card bg-base-200 shadow-sm">
                    <div class="card-body">
                        <h3 class="card-title">Volunteers</h3>
                        <p>
                            If you want to help make SCMF happen, we'd love your
                            help as a volunteer. While entry is free for
                            everyone, we pride ourselves on having wonderful
                            food for our volunteers. We welcome volunteers for
                            the entire event or whatever portion you're
                            available for.
                        </p>
                        <div class="card-actions justify-end">
                            <a
                                href="#contact-us"
                                class="btn btn-primary text-primary-content"
                                >Sign up to volunteer</a
                            >
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</GenericSection>
