---
import GenericSection from "../components/GenericSection.astro";
import SectionTitle from "../components/SectionTitle.astro";

// import Image from "astro/components/Image.astro";
import jencar from "../img/2016/IMG_7545.JPG";
---

<GenericSection name="About">
    <div class="flex flex-col lg:flex-row items-center lg:items-stretch gap-4">
        <div class="flex flex-col justify-center gap-4">
            <SectionTitle name="About" />
            <p>
                Since 2016, Sussex County Maker Fest has operated under a few
                different names, bringing together creative, innovative people,
                artists, and DIY enthusiasts to celebrate and share their
                projects.
            </p>

            <p>
                Hosted by Ideal Farm & Garden Center in Lafayette, NJ, Sussex
                County Maker Fest features a robot combat tournament hosted by
                GSCRL, Power Racing Series races,demonstrations, hands-on
                workshops, all alongside Ideal Farm's usual family-friendly fall
                activities.
            </p>
        </div>
        <img
            src={jencar.src}
            alt=""
            width="400"
            height="400"
            class="rounded-md shadow-sm"
        />
    </div>
</GenericSection>
